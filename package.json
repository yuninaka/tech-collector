    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "ever-better": "^0.4.1",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",

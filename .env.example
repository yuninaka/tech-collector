GEMINI_API_KEY=your_gemini_api_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional. JSON array of { "source": string, "feedUrl": string } to override the default
# sources (Zenn, Qiita, Hatena). Leave unset to use the defaults in src/config/articleSources.ts.
# ARTICLE_SOURCES=[{"source":"Zenn","feedUrl":"https://zenn.dev/feed"},{"source":"Qiita","feedUrl":"https://qiita.com/popular-items/feed"}]

# Optional. Comma-separated keywords used to prioritize articles whose title or snippet
# matches (case-insensitive). Matching articles are placed ahead of non-matching ones,
# newest-first within each group. Leave unset to use the defaults in src/config/priorityKeywords.ts.
# PRIORITY_KEYWORDS=AI駆動開発,RAG,Claude,LLM,生成AI,Agent,AIエージェント
